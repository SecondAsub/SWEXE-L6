<h1>カートに追加</h1>

<p>商品名：<%= @product.name %></p>
<p>価格：<%= number_with_delimiter(@product.price) %>円</p>

<%= form_with model: @cart_item, url: cart_items_path do |form| %>
  <%= form.hidden_field :product_id, value: @product.id %>

  <div>
    <%= form.label :qty, "数量" %>
    <%= form.number_field :qty, min: 1, required: true %>
  </div>

  <%= form.submit "カートに追加する" %>
<% end %>

<p>
  <%= link_to "商品一覧へ戻る", products_path %>
</p>